# Base URL of your Directus instance, no trailing slash
DIRECTUS_URL=https://your-directus.example.com
# Optional. A static token for a user whose role has read-only access to the
# xroads_bball_* collections and directus_files. Leave empty if the Public role can read them.
DIRECTUS_TOKEN=

# Schedule page: the id from your sheet URL (docs.google.com/spreadsheets/d/<ID>/edit).
# The sheet must be shared as "Anyone with the link can view".
GOOGLE_SHEET_ID=
# Optional: the number after gid= in the URL when the schedule is not the first tab
GOOGLE_SHEET_GID=0
